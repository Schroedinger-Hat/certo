			}

			a {
				color: var(--primary);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			a:hover {
				text-decoration: underline;
			}

			h1, h2, h3, h4, h5, h6 {
				font-family: 'Space Grotesk', sans-serif;
				font-weight: 600;
				color: var(--text-primary);
			}

			.site-header {
