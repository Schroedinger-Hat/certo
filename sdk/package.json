{
  "name": "@certo/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the Certo credential platform",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/Schroedinger-Hat/certo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schroedinger-Hat/certo.git",
    "directory": "sdk"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-cjs.mjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "extensionsToTreatAsEsm": [".ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "useESM": true, "isolatedModules": true, "diagnostics": { "ignoreCodes": [151002] } }]
    },
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    },
    "testEnvironment": "node",
    "testMatch": ["**/src/**/*.test.ts"]
  }
}
